# Copy this file to .env and fill in your values for local development.
# Never commit .env to git.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank locally to use SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Enterprise AI Agent (Lambda via API Gateway)
# Get AI_AGENT_URL from: terraform output -raw api_url   (inside terraform/ folder)
# Get AI_AGENT_API_KEY from: terraform output -raw api_key
AI_AGENT_URL=https://your-api-id.execute-api.ap-southeast-1.amazonaws.com/
AI_AGENT_API_KEY=your-api-key-here
